---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPortfolioContent } from '../../../lib/content';
import { toSlug, uniqueSlugs } from '../../../lib/slug';
import type { Article } from '../../../types/content';

export async function getStaticPaths() {
  const { articles } = await getPortfolioContent();
  return uniqueSlugs(articles.flatMap((article) => article.tags)).map((tag) => ({ params: { tag }, props: { tag, articles: articles.filter((article) => article.tags.some((value) => toSlug(value) === tag)) } }));
}
interface Props { tag: string; articles: Article[]; }
const { tag, articles } = Astro.props;
---
<BaseLayout title={`#${tag} Insights | Hengki Pranoto`} description={`Articles tagged ${tag}.`}><header class="page-hero surface-bright"><div class="shell"><p class="eyebrow">Insight tag</p><h1 style="margin-top:1.35rem">#{tag}</h1></div></header><section class="page-section-compact"><div class="shell insight-list">{articles.map((article) => <article class="insight-row"><span>{article.category}</span><div><h2><a href={`/insights/${article.slug}/`}>{article.title}</a></h2><p>{article.summary}</p></div><time datetime={article.publishedAt}>{article.publishedAt}</time></article>)}</div></section></BaseLayout>
