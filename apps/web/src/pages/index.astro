---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetricStrip from '../components/MetricStrip.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import SectionIntro from '../components/SectionIntro.astro';
import { getPortfolioContent } from '../lib/content';

const content = await getPortfolioContent();
const { settings, profile, metrics, caseStudies, principles, articles } = content;
const capabilities = [
  ['01', 'Solution and system architecture', 'Translate business requirements into explicit boundaries, interfaces, quality attributes, and evolution paths.'],
  ['02', 'Delivery and technical governance', 'Create standards and decision paths that reduce ambiguity without blocking teams.'],
  ['03', 'Infrastructure and platform operations', 'Include environments, deployment, ownership, resilience, and recovery in the system design.'],
  ['04', 'Observability and performance', 'Define signals and baselines before making reliability or optimization claims.'],
  ['05', 'Technical enablement and training', 'Turn architecture into reusable practices, reviews, and team capability.'],
  ['06', 'AI and workflow automation', 'Use bounded tools, deterministic controls, human approval, and auditable execution.']
];
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{profile.name} · {profile.title}</p>
        <h1>Pragmatic systems for <span class="accent">real constraints.</span></h1>
        <p class="hero-lead">{profile.statement}</p>
        <div class="hero-actions">
          <a class="button" href="/case-studies/">View case studies <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href={settings.resumeUrl} download>Download resume</a>
          <a class="text-link" href="/contact/">Start a conversation</a>
        </div>
      </div>
      <aside class="hero-brief" aria-label="Professional brief">
        <dl>
          <div><dt>Based in</dt><dd>{profile.location}</dd></div>
          <div><dt>Industry context</dt><dd>BFSI · Manufacturing · Oil and gas</dd></div>
          <div><dt>Focus</dt><dd>Architecture · Delivery · Operations</dd></div>
          <div><dt>Availability</dt><dd>{settings.availability}</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="page-section-compact">
    <div class="shell">
      <MetricStrip metrics={metrics} />
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <SectionIntro eyebrow="Selected evidence" title="Architecture decisions, delivery constraints, and outcomes." description="Each case study separates verified facts from withheld details and R&D. No invented savings, scale, or performance claims." />
      <div class="case-list">
        {caseStudies.filter((study) => study.featured).map((study, index) => <CaseStudyCard study={study} index={index} />)}
      </div>
    </div>
  </section>

  <section class="page-section surface-bright border-top">
    <div class="shell">
      <SectionIntro eyebrow="Capability map" title="Breadth organized around outcomes, not tool scores." description="Technology choices follow the problem, the operating model, and the team responsible for the result." />
      <div class="capability-grid">
        {capabilities.map(([number, title, description]) => (
          <article class="capability-card">
            <span>{number}</span>
            <div><h3>{title}</h3><p>{description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section surface-dark">
    <div class="shell">
      <SectionIntro eyebrow="Decision framework" title="Principles that survive contact with production." description="The strongest architecture is the one a team can deliver, observe, recover, and evolve." />
      <div class="principles-preview">
        {principles.slice(0, 4).map((principle) => (
          <article class="principle-card">
            <span>{principle.number}</span>
            <div><h3>{principle.title}</h3><p>{principle.description}</p></div>
          </article>
        ))}
      </div>
      <p style="margin-top: 2rem"><a class="text-link" href="/principles/">Explore all architecture principles <span aria-hidden="true">↗</span></a></p>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <SectionIntro eyebrow="Latest insights" title="Notes on decisions, delivery, and operational reality." />
      <div class="article-grid">
        {articles.slice(0, 3).map((article) => (
          <article class="article-card">
            <div>
              <p class="eyebrow">{article.category}</p>
              <h3><a href={`/insights/${article.slug}/`}>{article.title}</a></h3>
              <p>{article.summary}</p>
            </div>
            <div class="article-meta"><time datetime={article.publishedAt}>{article.publishedAt}</time><span>{article.readingMinutes} min read</span></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section surface-dark">
    <div class="shell contact-band">
      <div>
        <p class="eyebrow">Complex system? Hard deadline? Operational risk?</p>
        <h2>Let’s examine the architecture and trade-offs.</h2>
        <p>For modernization programs, platform adoption, delivery constraints, and carefully bounded AI workflows.</p>
      </div>
      <div class="contact-actions">
        <a class="button" href="/contact/">Contact Hengki <span aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href="/case-studies/">Review the evidence</a>
      </div>
    </div>
  </section>
</BaseLayout>
