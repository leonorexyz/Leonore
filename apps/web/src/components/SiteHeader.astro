---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/case-studies/', label: 'Case Studies' },
  { href: '/experience/', label: 'Experience' },
  { href: '/principles/', label: 'Principles' },
  { href: '/insights/', label: 'Insights' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' }
];

const isCurrent = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="HP Hengki Pranoto home">
      <span class="wordmark-mark" aria-hidden="true">HP</span>
      <span>
        <strong>Hengki Pranoto</strong>
        <small>Solution Architect</small>
      </span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <details class="mobile-menu">
      <summary aria-label="Menu — open navigation">Menu</summary>
      <nav aria-label="Mobile navigation">
        {links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
