---
import type { CaseStudy } from '../types/content';

interface Props {
  study: CaseStudy;
  index?: number;
}

const { study, index = 0 } = Astro.props;
---

<article class="case-card">
  <div class="case-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
  <div class="case-card-body">
    <div class="card-meta">
      <span>{study.industry}</span>
      <span class:list={['status', study.status === 'R&D' && 'status-rd']}>{study.status}</span>
    </div>
    <h3><a href={`/case-studies/${study.slug}/`}>{study.title}</a></h3>
    <p>{study.summary}</p>
    <dl class="decision-snapshot">
      <div><dt>Role</dt><dd>{study.role}</dd></div>
      <div><dt>Key decision</dt><dd>{study.decisions[0]}</dd></div>
      <div><dt>Outcome</dt><dd>{study.outcome}</dd></div>
    </dl>
    <div class="tag-list" aria-label="Capabilities">
      {study.capabilities.map((capability) => <span>{capability}</span>)}
    </div>
    <a class="text-link" href={`/case-studies/${study.slug}/`}>Read the case study <span aria-hidden="true">↗</span></a>
  </div>
</article>
